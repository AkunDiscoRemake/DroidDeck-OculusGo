<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application android:label="DroidDeck Go" tools:replace="android:label">
        <!-- The Go shows 2D activities of a VR app unwarped across both lenses; this app is VR only. -->
        <meta-data android:name="com.samsung.android.vr.application.mode" android:value="vr_only" />
        <meta-data android:name="com.oculus.supportedDevices" android:value="go|quest2|quest3|quest3s"
            tools:replace="android:value" />

        <activity-alias android:name=".MainActivity" android:enabled="false" tools:replace="android:enabled" />

        <activity android:name=".OculusGoVrActivity" android:exported="true" android:launchMode="singleTask"
            android:resizeableActivity="false" android:screenOrientation="landscape"
            android:excludeFromRecents="false"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <meta-data android:name="android.app.lib_name" android:value="droiddeckgo" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="com.oculus.intent.category.VR" />
            </intent-filter>
        </activity>
    </application>
</manifest>
